{
  "name": "@yaseenhq/acp-server",
  "version": "0.0.2",
  "private": true,
  "description": "ACP v2 server for Echadron, backed by the existing SDK harness",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
