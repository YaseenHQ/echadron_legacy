  "dependencies": {
    "@agentclientprotocol/sdk-v2": "npm:@agentclientprotocol/sdk@^1.3.0",
    "@yaseenhq/acp-adapter": "workspace:^",
    "@yaseenhq/echadron-sdk": "workspace:^"
  }
}
