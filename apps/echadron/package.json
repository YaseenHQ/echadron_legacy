{
	"name": "echadron",
	"version": "0.33.1",
	"description": "Echadron multi-provider agent harness for the terminal",
	"license": "MIT",
	"author": "YaseenHQ",
	"homepage": "https://github.com/YaseenHQ/echadron/tree/main/apps/echadron#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/YaseenHQ/echadron.git",
		"directory": "apps/echadron"
	},
	"bugs": {
		"url": "https://github.com/YaseenHQ/echadron/issues"
	},
	"keywords": [
		"echadron",
		"cli",
		"agent",
		"coding-agent",
		"ai",
		"tui"
	],
	"bin": {
		"echadron": "dist/main.mjs",
		"chad": "dist/main.mjs",
		"maker": "dist/main.mjs"
	},
	"files": [
		"dist",
		"dist-web",
		"native",
		"README.md"
	],
	"type": "module",
	"imports": {
		"#/tui/theme": "./src/tui/theme/index.ts",
		"#/tui/commands": "./src/tui/commands/index.ts",
		"#/cli/sub/web": "./src/cli/sub/web/index.ts",
		"#/cli/sub/web/*": "./src/cli/sub/web/*.ts",
		"#/generated/vis-web-asset": [
			"./src/generated/vis-web-asset.ts",
			"./src/generated/vis-web-asset.d.ts"
		],
		"#/*": "./src/*.ts"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"build": "pnpm -C ../echadron-web run build && tsdown && node scripts/copy-native-assets.mjs && node scripts/copy-web-assets.mjs",
		"prebuild": "node scripts/build-vis-asset.mjs",
		"catalog:update": "node scripts/update-catalog.mjs --out dist/built-in-catalog.json",
		"smoke": "node scripts/smoke.mjs",
		"build:native:js": "node scripts/native/01-bundle.mjs",
		"build:native:sea": "node scripts/native/build.mjs --profile=local",
		"build:native:release": "node scripts/native/build.mjs --profile=release",
		"package:native": "node scripts/native/package.mjs",
		"produce:native:manifest": "node scripts/native/produce-manifest.mjs",
		"release:native:resolve": "node scripts/native/resolve-release.mjs",
		"test:native:smoke": "node scripts/native/smoke.mjs",
		"dev": "node scripts/dev.mjs",
		"dev:cli-only": "node scripts/dev-entry.mjs",
		"dev:server": "node scripts/dev-entry.mjs web --no-open --debug-endpoints",
		"dev:kap-server": "node scripts/dev-entry.mjs web --no-open --debug-endpoints",
		"dev:kap-server:multi": "node scripts/dev-entry.mjs web --no-open --debug-endpoints",
		"dev:server:restart": "node scripts/dev-server-restart.mjs",
		"dev:plugin-marketplace": "node scripts/dev-plugin-marketplace-server.mjs",
		"build:plugin-marketplace": "node scripts/build-plugin-marketplace-cdn.mjs",
		"dev:prod": "node dist/main.mjs",
		"clean": "rm -rf dist",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"test": "pnpm -w run build:packages && vitest run",
		"e2e": "pnpm -w run build:packages && KIMI_E2E=1 vitest run test/e2e",
		"e2e:real": "pnpm -w run build:packages && KIMI_E2E_REAL=1 vitest run test/e2e/real-llm-smoke.e2e.test.ts"
	},
	"optionalDependencies": {
		"@firecrawl/anydoc": "^0.1.8",
		"@lydell/node-pty": "1.2.0-beta.15",
		"@mariozechner/clipboard": "^0.3.9"
	},
	"devDependencies": {
		"@types/semver": "^7.7.0",
		"@types/yazl": "^2.4.6",
		"@yaseenhq/acp-adapter": "workspace:^",
		"@yaseenhq/acp-server": "workspace:^",
		"@yaseenhq/agent-core-v2": "workspace:^",
		"@yaseenhq/echadron-oauth": "workspace:^",
		"@yaseenhq/echadron-sdk": "workspace:^",
		"@yaseenhq/echadron-telemetry": "workspace:^",
		"@yaseenhq/echadron-web": "workspace:^",
		"@yaseenhq/kap-server": "workspace:^",
		"@yaseenhq/migration-legacy": "workspace:^",
		"@yaseenhq/pi-tui": "workspace:^",
		"@yaseenhq/vis-server": "workspace:^",
		"@yaseenhq/vis-web": "workspace:*",
		"chalk": "^5.4.1",
		"cli-highlight": "^2.1.11",
		"commander": "^13.1.0",
		"jimp": "^1.6.1",
		"pathe": "^2.0.3",
		"postject": "1.0.0-alpha.6",
		"semver": "^7.7.4",
		"smol-toml": "^1.6.1",
		"tsx": "^4.21.0",
		"unicode-animations": "^1.0.3",
		"yazl": "^3.3.1",
		"zod": "^4.3.6"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
